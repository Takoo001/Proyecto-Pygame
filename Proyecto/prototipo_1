pygame.mixer.music.play(-1)




fondo_menu = pygame.image.load("fondo_bosque.png")
fondo_menu = pygame.transform.scale(fondo_menu, (1920, 1080))

panel_menu = pygame.image.load("fondo_menu.png")     
